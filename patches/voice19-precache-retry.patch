+package com.maxrave.media3.exoplayer
+
+import androidx.media3.common.PlaybackException
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Pins the precache retry policy ported in voice19: only the three source errors a fresh stream
+ * URL can fix are retried. Everything else, including the IO_UNSPECIFIED (2000) seen in the
+ * reported playback failure, must stay non-retryable so it surfaces instead of looping.
+ */
+class PrecacheRetryPolicyTest {
+    private fun error(code: Int) = PlaybackException("test", null, code)
+
+    @Test
+    fun freshUrlFixableSourceErrorsAreRetried() {
+        assertTrue(error(PlaybackException.ERROR_CODE_PARSING_CONTAINER_MALFORMED).isRetryableSourceError())
+        assertTrue(error(PlaybackException.ERROR_CODE_IO_BAD_HTTP_STATUS).isRetryableSourceError())
+        assertTrue(error(PlaybackException.ERROR_CODE_IO_FILE_NOT_FOUND).isRetryableSourceError())
+    }
+
+    @Test
+    fun genericAndNetworkErrorsAreNotRetried() {
+        assertFalse(error(PlaybackException.ERROR_CODE_IO_UNSPECIFIED).isRetryableSourceError())
+        assertFalse(error(PlaybackException.ERROR_CODE_IO_NETWORK_CONNECTION_FAILED).isRetryableSourceError())
+        assertFalse(error(PlaybackException.ERROR_CODE_IO_NETWORK_CONNECTION_TIMEOUT).isRetryableSourceError())
+        assertFalse(error(PlaybackException.ERROR_CODE_TIMEOUT).isRetryableSourceError())
+    }
+}
