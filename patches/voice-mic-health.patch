@@ -0,0 +1,121 @@
+package com.maxrave.media3.voice
+
+/**
+ * Diagnostic only. Collects what the wake listener's microphone is actually doing so the on-screen
+ * status does not rely on "listening ON" alone. It never changes behaviour: no retries, no restarts.
+ * Numbers only, no audio is kept.
+ */
+internal class VoiceMicHealth {
+    private val lock = Any()
+    private val frames = ArrayDeque<Pair<Long, Int>>() // (time ms, peak of that read)
+    private var silenced: Boolean? = null
+    private var deviceType: Int? = null
+    private var wakeStarts = 0
+    private var lastFault: String? = null
+
+    fun onWakeStart() {
+        synchronized(lock) { wakeStarts += 1 }
+    }
+
+    fun onFrame(
+        peak: Int,
+        nowMs: Long,
+    ) {
+        synchronized(lock) {
+            frames.addLast(nowMs to peak)
+            prune(nowMs)
+        }
+    }
+
+    /** Null means Android has not told us. */
+    fun onSilenced(value: Boolean?) {
+        synchronized(lock) {
+            if (value != null) silenced = value
+        }
+    }
+
+    fun onDevice(type: Int?) {
+        synchronized(lock) {
+            if (type != null) deviceType = type
+        }
+    }
+
+    fun onFault(reason: String) {
+        synchronized(lock) { lastFault = reason }
+    }
+
+    /** A new AudioRecord starts with no knowledge of the previous one. */
+    fun onRecorderCreated() {
+        synchronized(lock) {
+            silenced = null
+            deviceType = null
+        }
+    }
+
+    private fun prune(nowMs: Long) {
+        while (frames.isNotEmpty() && nowMs - frames.first().first > WINDOW_MS) frames.removeFirst()
+    }
+
+    fun report(
+        stageName: String,
+        wakeListenerRunning: Boolean,
+        nowMs: Long,
+    ): String =
+        synchronized(lock) {
+            prune(nowMs)
+            val n = frames.size
+            val peak = frames.maxOfOrNull { it.second } ?: 0
+            val audio =
+                when {
+                    !wakeListenerRunning -> "Wake microphone is paused in this stage"
+                    n == 0 -> "No audio reads in the last 5 s"
+                    peak == 0 -> "Audio reads in last 5 s: $n, every sample was zero"
+                    else -> "Audio reads in last 5 s: $n, loudest sample $peak of 32767"
+                }
+            val sil =
+                when (silenced) {
+                    true -> "Android reports the capture is silenced (cause not identified)"
+                    false -> "Android reports the capture is not silenced"
+                    null -> "Silence state: not reported by Android"
+                }
+            buildString {
+                append("Stage: ").append(stageName).append(", wake listener starts since ON: ").append(wakeStarts).append('\n')
+                append(audio).append('\n')
+                append(sil).append('\n')
+                append("Input device: ").append(deviceName(deviceType))
+                lastFault?.let { append('\n').append("Last wake listener fault: ").append(it) }
+            }
+        }
+
+    companion object {
+        const val WINDOW_MS = 5000L
+
+        fun peakOf(
+            shorts: ShortArray,
+            n: Int,
+        ): Int {
+            var peak = 0
+            for (i in 0 until n) {
+                val v = shorts[i].toInt()
+                val a = if (v < 0) -v else v // -32768 gives 32768, which is fine here
+                if (a > peak) peak = a
+            }
+            return peak
+        }
+
+        /** Names for android.media.AudioDeviceInfo.TYPE_* values (kept numeric so tests run on the JVM). */
+        fun deviceName(type: Int?): String =
+            when (type) {
+                null -> "unknown"
+                15 -> "built-in microphone"
+                7 -> "Bluetooth SCO headset"
+                8 -> "Bluetooth A2DP"
+                26 -> "Bluetooth LE headset"
+                3 -> "wired headset"
+                4 -> "wired headphones"
+                11 -> "USB device"
+                22 -> "USB headset"
+                else -> "other (type $type)"
+            }
+    }
+}
