+    /** Reads what Android says about this recorder (API 29+). Diagnostic only. */
+    @SuppressLint("NewApi")
+    private fun registerHealthCallback(
+        record: AudioRecord,
+        health: VoiceMicHealth,
+    ): AudioManager.AudioRecordingCallback? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return null
+        return try {
+            val cb =
+                object : AudioManager.AudioRecordingCallback() {
+                    override fun onRecordingConfigChanged(configs: MutableList<AudioRecordingConfiguration>?) {
+                        configs?.firstOrNull { it.clientAudioSessionId == record.audioSessionId }?.let {
+                            health.onSilenced(it.isClientSilenced)
+                            health.onDevice(it.audioDevice?.type)
+                        }
+                    }
+                }
+            record.registerAudioRecordingCallback({ it.run() }, cb)
+            cb
+        } catch (e: Throwable) {
+            Logger.w(TAG, "recording callback unavailable: ${e.message}")
+            null
+        }
+    }
+
