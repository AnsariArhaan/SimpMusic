+        record: AudioRecord,
+        health: VoiceMicHealth,
+    ) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return
+        try {
+            record.activeRecordingConfiguration?.let {
+                health.onSilenced(it.isClientSilenced)
+                health.onDevice(it.audioDevice?.type)
+            }
+            health.onDevice(record.routedDevice?.type)
+        } catch (_: Throwable) {
+        }
+    }
