+package com.maxrave.media3.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceMicHealthTest {
+    @Test
+    fun peakOfHandlesNegativesAndMinValue() {
+        assertEquals(0, VoiceMicHealth.peakOf(shortArrayOf(0, 0, 0), 3))
+        assertEquals(300, VoiceMicHealth.peakOf(shortArrayOf(10, -300, 200), 3))
+        assertEquals(32768, VoiceMicHealth.peakOf(shortArrayOf(-32768), 1))
+        assertEquals(10, VoiceMicHealth.peakOf(shortArrayOf(10, 9999), 1)) // only n samples count
+    }
+
+    @Test
+    fun noReadsIsReportedAsNoReadsNotAsSilence() {
+        val h = VoiceMicHealth()
+        val r = h.report("wake", true, 10_000)
+        assertTrue(r, r.contains("No audio reads in the last 5 s"))
+        assertTrue(r, r.contains("not reported by Android"))
+    }
+
+    @Test
+    fun zeroSamplesAreReportedAsZeroWithoutNamingACause() {
+        val h = VoiceMicHealth()
+        for (t in 0 until 10) h.onFrame(0, 1_000L + t * 100)
+        val r = h.report("wake", true, 2_000)
+        assertTrue(r, r.contains("10, every sample was zero"))
+        assertTrue(r, !r.contains("muted"))
+    }
+
+    @Test
+    fun oldReadsAgeOutOfTheFiveSecondWindow() {
+        val h = VoiceMicHealth()
+        h.onFrame(5000, 0)
+        h.onFrame(100, 4_000)
+        val r = h.report("wake", true, 6_000)
+        assertTrue(r, r.contains("reads in last 5 s: 1, loudest sample 100"))
+    }
+
+    @Test
+    fun silencedFlagAndDeviceAreShownAsReported() {
+        val h = VoiceMicHealth()
+        h.onSilenced(true)
+        h.onDevice(8)
+        h.onWakeStart()
+        h.onWakeStart()
+        h.onFault("audio read error -3")
+        val r = h.report("wake", true, 0)
+        assertTrue(r, r.contains("silenced (cause not identified)"))
+        assertTrue(r, r.contains("Input device: Bluetooth A2DP"))
+        assertTrue(r, r.contains("starts since ON: 2"))
+        assertTrue(r, r.contains("fault: audio read error -3"))
+        h.onSilenced(null) // unknown does not erase a known value
+        assertTrue(h.report("wake", true, 0).contains("silenced (cause"))
+        h.onRecorderCreated() // a new recorder resets it
+        assertTrue(h.report("wake", true, 0).contains("Silence state: not reported"))
+    }
+
+    @Test
+    fun pausedStageSaysSo() {
+        val r = VoiceMicHealth().report("command", false, 0)
+        assertTrue(r, r.contains("paused in this stage"))
+    }
+}
