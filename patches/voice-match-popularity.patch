+    // ---- Romanised spelling tolerance and popularity tie-break (approved voice15 scope) ----
+
+    private const val FUZZY_MIN_LEN = 8
+    private const val FUZZY_MAX_DIST = 2
+    private const val WORD_FUZZY_MIN_LEN = 5
+
+    /** Banded Levenshtein: true only when the edit distance is at most [max]. */
+    internal fun levenshteinLeq(
+        a: String,
+        b: String,
+        max: Int,
+    ): Boolean {
+        if (kotlin.math.abs(a.length - b.length) > max) return false
+        var prev = IntArray(b.length + 1) { it }
+        for (i in 1..a.length) {
+            val cur = IntArray(b.length + 1)
+            cur[0] = i
+            var rowMin = Int.MAX_VALUE
+            for (j in 1..b.length) {
+                val cost = if (a[i - 1] == b[j - 1]) 0 else 1
+                cur[j] = minOf(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
+                if (cur[j] < rowMin) rowMin = cur[j]
+            }
+            if (rowMin > max) return false
+            prev = cur
+        }
+        return prev[b.length] <= max
+    }
+
+    /**
+     * Romanised spelling tolerance for titles ("chhammak chhallo" = "chammak challo"): at most two
+     * edits, same first letter, and only when both sides have 8+ normalised characters. Shorter
+     * titles stay exact so unrelated short titles can never fuzzy-match.
+     */
+    fun titleEquiv(
+        a: String,
+        b: String,
+    ): Boolean {
+        if (a == b) return true
+        if (a.isEmpty() || b.isEmpty()) return false
+        if (minOf(a.length, b.length) < FUZZY_MIN_LEN) return false
+        if (a.first() != b.first()) return false
+        return levenshteinLeq(a, b, FUZZY_MAX_DIST)
+    }
+
+    /**
+     * A heard word explained by a word set: exact, or one edit away when both words are 5+ chars and
+     * start with the same letter (transliteration tolerance, not a general near-word match).
+     */
+    private fun wordIn(
+        w: String,
+        s: Set<String>,
+    ): Boolean =
+        w in s ||
+            (
+                w.length >= WORD_FUZZY_MIN_LEN &&
+                    s.any { it.length >= WORD_FUZZY_MIN_LEN && it.first() == w.first() && levenshteinLeq(w, it, 1) }
+            )
