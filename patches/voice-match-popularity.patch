+    /** Per-candidate popularity for the tie-break. Null views = unknown, not zero. */
+    data class Pop(
+        val views: Long?,
+        val saved: Boolean,
+        val plays: Long,
+    )
+
+    /** One videos-shelf row, used only as a public view-count source; never playable itself. */
+    data class ViewRow(
+        val title: String,
+        val artists: List<String>,
+        val views: Long?,
+    )
+
+    private val viewsText = Regex("(?i)^\s*([\d.,]+)\s*([KMB]?)\s+views?\s*$")
+
+    /** "760M views" -> 760000000; "No views", unparseable or missing -> null. */
+    fun parseViews(text: String?): Long? {
+        if (text == null) return null
+        val m = viewsText.find(text) ?: return null
+        val num = m.groupValues[1].replace(",", "").toDoubleOrNull() ?: return null
+        val mult =
+            when (m.groupValues[2].uppercase()) {
+                "K" -> 1_000L
+                "M" -> 1_000_000L
+                "B" -> 1_000_000_000L
+                else -> 1L
+            }
+        return (num * mult).toLong()
+    }
+
+    /** Extra video-row tags that disqualify a view-count source even when the artist agrees. */
+    private val viewRowBlocked = setOf("lyric", "lyrics", "reupload", "reuploaded", "short", "shorts", "amv", "fmv", "edit", "sped")
+
+    /**
+     * Whether a videos-shelf row may donate its view count: same variant guards as playback
+     * (an unasked live/remix/cover version never donates) plus video-only tags like lyrics/AMV.
+     */
+    private fun viewRowEligible(
+        wanted: String,
+        title: String,
+    ): Boolean {
+        if (isUnaskedVariant(wanted, title)) return false
+        val asked = wanted.split(' ').toSet()
+        val tokens = title.lowercase().split(nonWord).filter { it.isNotEmpty() }
+        return tokens.none { it in viewRowBlocked && it !in asked }
+    }
+
+    /**
+     * Public views for a song candidate: the videos-shelf row must carry the same normalised title,
+     * share at least one artist word, and pass the version guards, so a same-title cover, lyric
+     * video or another artist's upload never donates views. No eligible row -> unknown, not zero.
+     */
+    fun viewsFor(
+        wanted: String,
+        c: Cand,
+        rows: List<ViewRow>,
+    ): Long? {
+        val myTitle = normalize(c.title)
+        val myArtists = c.artists.flatMap { words(it) }.toSet()
+        return rows
+            .filter { r ->
+                viewRowEligible(wanted, r.title) &&
+                    normalize(r.title) == myTitle &&
+                    r.artists.flatMap { words(it) }.any { it in myArtists }
+            }.mapNotNull { it.views }
+            .maxOrNull()
+    }
+
+    /**
+     * Tie-break between several matching versions of the requested title; popularity never makes a
+     * non-matching song playable. Public views first: a unique highest known count wins. Equal or
+     * unknown views fall back to the user's own data: a unique saved (liked/playlisted) track wins,
+     * otherwise a unique highest local play count wins. Still tied -> null and the caller refuses.
+     */
+    private fun popularityPick(
+        hits: List<Cand>,
+        pop: Map<String, Pop>,
+    ): Cand? {
+        val withViews = hits.mapNotNull { h -> pop[h.videoId]?.views?.let { h to it } }
+        if (withViews.isNotEmpty()) {
+            val maxViews = withViews.maxOf { it.second }
+            val winners = withViews.filter { it.second == maxViews }
+            if (winners.size == 1) return winners[0].first
+        }
+        val saved = hits.filter { pop[it.videoId]?.saved == true }
+        if (saved.size == 1) return saved[0]
+        val pool = if (saved.size > 1) saved else hits
+        val withPlays = pool.mapNotNull { h -> pop[h.videoId]?.plays?.takeIf { it > 0 }?.let { h to it } }
+        if (withPlays.isNotEmpty()) {
+            val maxPlays = withPlays.maxOf { it.second }
+            val winners = withPlays.filter { it.second == maxPlays }
+            if (winners.size == 1) return winners[0].first
+        }
+        return null
+    }
