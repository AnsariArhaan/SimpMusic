+package com.maxrave.media3.service.callback
+
+/**
+ * Resolves a spoken search query (for example from Google Assistant / Gemini) to a liked-song
+ * index. Pure Kotlin so it is unit-testable on the JVM.
+ *
+ * Rules: strip a trailing "from/in/on (my) liked/favourite(s) (songs)" qualifier; an empty
+ * remainder never plays; an exact title match (case-insensitive) wins; otherwise a single
+ * "contains" match plays; several possible matches are ambiguous and return null so nothing
+ * unexpected starts playing.
+ */
+internal object VoiceLikedSongMatcher {
+    private val qualifier =
+        Regex("(?i)\\s+(from|in|on)\\s+(my\\s+)?(liked|favou?rite)s?( songs)?\\s*$")
+
+    fun resolve(
+        query: String,
+        titles: List<String>,
+    ): Int? {
+        val wanted = query.trim().replace(qualifier, "").trim().lowercase()
+        if (wanted.isEmpty()) return null
+        val exact = titles.indexOfFirst { it.lowercase() == wanted }
+        if (exact >= 0) return exact
+        val contains = titles.withIndex().filter { it.value.lowercase().contains(wanted) }
+        return if (contains.size == 1) contains.first().index else null
+    }
+}
