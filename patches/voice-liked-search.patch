@@ -0,0 +1,47 @@
+package com.maxrave.media3.service.callback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class VoiceLikedSongMatcherTest {
+    private val titles = listOf("Royalty", "Night Changes", "Royalty Free Beats", "Royals")
+
+    @Test
+    fun exactTitlePlays() {
+        assertEquals(0, VoiceLikedSongMatcher.resolve("Royalty", titles))
+    }
+
+    @Test
+    fun likedSongsQualifierIsStripped() {
+        assertEquals(0, VoiceLikedSongMatcher.resolve("Royalty from liked songs", titles))
+        assertEquals(0, VoiceLikedSongMatcher.resolve("Royalty in my favourites", titles))
+        assertEquals(0, VoiceLikedSongMatcher.resolve("Royalty on favorites", titles))
+    }
+
+    @Test
+    fun matchingIsCaseInsensitive() {
+        assertEquals(1, VoiceLikedSongMatcher.resolve("night changes from liked songs", titles))
+    }
+
+    @Test
+    fun bareLikedSongsRequestDoesNotPlay() {
+        assertNull(VoiceLikedSongMatcher.resolve("play from liked songs", titles))
+        assertNull(VoiceLikedSongMatcher.resolve("liked songs", titles))
+    }
+
+    @Test
+    fun ambiguousQueryDoesNotPlay() {
+        assertNull(VoiceLikedSongMatcher.resolve("royal", titles))
+    }
+
+    @Test
+    fun uniquePartialMatchPlays() {
+        assertEquals(1, VoiceLikedSongMatcher.resolve("changes", titles))
+    }
+
+    @Test
+    fun unknownSongDoesNotPlay() {
+        assertNull(VoiceLikedSongMatcher.resolve("unknown track from liked songs", titles))
+    }
+}
