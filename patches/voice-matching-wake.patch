+++ b/media/media3/src/main/java/com/maxrave/media3/service/callback/VoiceTitleMatcher.kt
@@ -112,4 +112,118 @@ internal object VoiceTitleMatcher {
         val titleSet = normalize(title).split(' ').toSet()
         return wanted.split(' ').filter { it.isNotEmpty() && it !in allowedExtra }.any { it !in titleSet }
     }
+
+    // ---- Movie / album / artist qualifier and same-title ambiguity (online + liked) ----
+
+    /** What was said, split into the title words and an optional "from <movie/album>" part. */
+    data class Spoken(
+        val full: String,
+        val title: String,
+        val qualifier: List<String>,
+    )
+
+    private val fromSplit = Regex("\\s+(?:from|of|by|movie|film|album)\\s+")
+    private val numberWords = mapOf("one" to "1", "two" to "2", "three" to "3", "four" to "4", "five" to "5", "zero" to "0")
+
+    private val qualifierFiller = setOf("the", "a", "an", "movie", "film", "album", "song", "ost", "by", "from")
+
+    private fun canon(word: String): String = numberWords[word] ?: word
+
+    fun words(text: String): List<String> =
+        normalize(text).split(' ').filter { it.isNotEmpty() }.map { canon(it) }
+
+    /** Words in brackets, e.g. the movie in `Chammak Challo (From "Ra.One")`. */
+    private fun bracketWords(title: String): List<String> =
+        bracketed.findAll(title).flatMap { words(it.value.trim('(', ')', '[', ']')).asSequence() }.toList()
+
+    fun parse(query: String): Spoken {
+        val full = wantedFrom(query)
+        val parts = fromSplit.split(" $full ".trim(), limit = 2)
+        val title = parts[0].trim()
+        val qual = if (parts.size == 2) words(parts[1]).filter { it !in qualifierFiller } else emptyList()
+        return Spoken(full = full, title = title, qualifier = qual)
+    }
+
+    data class Cand(
+        val title: String,
+        val artists: List<String>,
+        val album: String?,
+        val videoId: String,
+    )
+
+    /** Every qualifier word appears in the album, a bracket of the title, or an artist name. */
+    fun qualifierSatisfied(
+        qualifier: List<String>,
+        c: Cand,
+    ): Boolean {
+        if (qualifier.isEmpty()) return true
+        val pool = (words(c.album ?: "") + bracketWords(c.title) + c.artists.flatMap { words(it) }).toSet()
+        return qualifier.all { it in pool }
+    }
+
+    private fun titleHit(
+        spoken: Spoken,
+        c: Cand,
+    ): Boolean =
+        normalize(c.title).let { n -> n == spoken.full || (spoken.qualifier.isNotEmpty() && n == spoken.title) } &&
+            !isUnaskedVariant(spoken.full, c.title)
+
+    sealed interface Online {
+        data class Play(
+            val videoId: String,
+        ) : Online
+
+        data class Refuse(
+            val reason: String,
+        ) : Online
+    }
+
+    /**
+     * Decision for an online search result list. Fail closed:
+     *  - a spoken movie/album must be found in the track's album, title brackets or artists;
+     *  - with only a title spoken, it plays only when exactly one same-title track exists in the
+     *    results (several versions of one title are never guessed between);
+     *  - an artist spoken (words beyond the title) falls back to [acceptOnline].
+     */
+    fun decideOnline(
+        spoken: Spoken,
+        results: List<Cand>,
+    ): Online {
+        if (spoken.title.length < 4) return Online.Refuse("too short")
+        val hits = results.filter { titleHit(spoken, it) }.distinctBy { it.videoId }
+        if (spoken.qualifier.isNotEmpty()) {
+            val ok = hits.filter { qualifierSatisfied(spoken.qualifier, it) }
+            if (ok.isEmpty()) {
+                val seen = hits.take(3).joinToString(", ") { "\"${it.title}\" (${it.album ?: it.artists.firstOrNull() ?: "?"})" }
+                return Online.Refuse("no \"${spoken.title}\" matched \"${spoken.qualifier.joinToString(" ")}\"" + if (seen.isNotEmpty()) ". Found: $seen" else "")
+            }
+            val artistSets = ok.map { it.artists.firstOrNull()?.let { a -> normalize(a) } ?: "" }.distinct()
+            if (artistSets.size > 1) return Online.Refuse("several \"${spoken.title}\" match that movie/album; say the artist too")
+            return Online.Play(ok.first().videoId)
+        }
+        if (hits.size == 1 && results.firstOrNull()?.videoId == hits.first().videoId) return Online.Play(hits.first().videoId)
+        if (hits.size > 1) {
+            val seen = hits.take(3).joinToString(", ") { "${it.artists.firstOrNull() ?: "?"}${it.album?.let { a -> " ($a)" } ?: ""}" }
+            return Online.Refuse("several versions of \"${spoken.title}\": $seen. Say the movie or artist too")
+        }
+        // No same-title hit: only an artist-qualified request ("title by artist") may still match.
+        val byArtist = results.filter { acceptOnline(spoken.full, it.title, it.artists) && heardArtist(spoken.full, it.title) }
+        val primary = byArtist.map { it.artists.firstOrNull()?.let { a -> normalize(a) } ?: "" }.distinct()
+        if (byArtist.isNotEmpty() && primary.size == 1) return Online.Play(byArtist.first().videoId)
+        return Online.Refuse("no confident match for \"${spoken.full}\"")
+    }
+
+    /** Liked-songs variant: with a spoken qualifier the album/bracket/artist must agree too. */
+    fun matchLikedQualified(
+        spoken: Spoken,
+        liked: List<Cand>,
+    ): Liked {
+        if (spoken.qualifier.isEmpty()) return matchLiked(spoken.full, liked.map { it.title })
+        val idx = liked.indices.filter { titleHit(spoken, liked[it]) && qualifierSatisfied(spoken.qualifier, liked[it]) }
+        return when (idx.size) {
+            0 -> Liked.None
+            1 -> Liked.Play(idx[0])
+            else -> Liked.Ambiguous(idx.take(5))
+        }
+    }
 }
