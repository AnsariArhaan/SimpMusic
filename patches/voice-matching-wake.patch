@@ -0,0 +1,49 @@
+package com.maxrave.media3.voice
+
+/**
+ * Accepts a wake only from a FINAL recognizer result, never from a streaming partial. A grammar
+ * recognizer force-fits nearby speech to the wake phrase, so the checks here are what stands between
+ * background talk and an open microphone: the text must be exactly the phrase, every word must carry
+ * a confidence at or above [MIN_CONFIDENCE], and the spoken span must have a plausible length.
+ *
+ * The thresholds are starting values chosen without real recordings. They are NOT measured against
+ * the user's voice or against background speech; every rejection is reported with its reason so the
+ * values can be tuned from phone evidence.
+ */
+internal object VoiceWakeGate {
+    const val MIN_CONFIDENCE = 0.80
+    const val MIN_SPAN_SECONDS = 0.30
+    const val MAX_SPAN_SECONDS = 1.60
+
+    data class Word(
+        val word: String,
+        val conf: Double,
+        val start: Double,
+        val end: Double,
+    )
+
+    sealed interface Verdict {
+        object Accept : Verdict
+
+        data class Reject(
+            val reason: String,
+        ) : Verdict
+    }
+
+    fun judge(
+        phrase: String,
+        text: String,
+        words: List<Word>?,
+    ): Verdict {
+        val heard = text.trim().lowercase()
+        if (heard != phrase) return Verdict.Reject("heard \"$heard\"")
+        val expected = phrase.split(' ')
+        if (words == null || words.size != expected.size) return Verdict.Reject("no word timings")
+        if (words.map { it.word.lowercase() } != expected) return Verdict.Reject("words differ")
+        val low = words.minOf { it.conf }
+        if (low < MIN_CONFIDENCE) return Verdict.Reject("low confidence ${"%.2f".format(low)}")
+        val span = words.last().end - words.first().start
+        if (span < MIN_SPAN_SECONDS || span > MAX_SPAN_SECONDS) return Verdict.Reject("span ${"%.2f".format(span)}s")
+        return Verdict.Accept
+    }
+}
diff --git a/cv/media/media3/src/test/java/com/maxrave/media3/service/callback/VoiceOnlineDecisionTest.kt b/media/media3/src/test/java/com/maxrave/media3/service/callback/VoiceOnlineDecisionTest.kt
