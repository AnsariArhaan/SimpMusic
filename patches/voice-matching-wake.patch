@@ -0,0 +1,76 @@
+package com.maxrave.media3.service.callback
+
+import com.maxrave.media3.service.callback.VoiceTitleMatcher.Cand
+import com.maxrave.media3.service.callback.VoiceTitleMatcher.Online
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Pure-logic regressions for the phone failure "chammak challo ... from Ra.One played a Bihari version". */
+class VoiceOnlineDecisionTest {
+    private val vishal = Cand("Chammak Challo", listOf("Vishal-Shekhar", "Akon", "Hamsika Iyer"), "Ra-One", "VS")
+    private val bihari = Cand("Chammak Challo", listOf("Dhanraj Banchor"), "Chammak Challo", "BH")
+    private val mani = Cand("Chammak Challo", listOf("Mani The Music"), "Chammak Challo", "MM")
+    private val bracketOnly = Cand("Chammak Challo (From \"Ra.One\")", listOf("Someone"), null, "BR")
+
+    private fun decide(q: String, vararg r: Cand) = VoiceTitleMatcher.decideOnline(VoiceTitleMatcher.parse(q), r.toList())
+
+    @Test
+    fun parseSplitsMovieQualifier() {
+        val s = VoiceTitleMatcher.parse("chammak challo from ra one")
+        assertEquals("chammak challo", s.title)
+        assertEquals(listOf("ra", "1"), s.qualifier)
+        assertEquals(listOf("ra", "1"), VoiceTitleMatcher.parse("Chammak Challo from Ra.One").qualifier)
+    }
+
+    @Test
+    fun movieQualifierPicksTheRightVersionNotTheBihariOne() {
+        assertEquals(Online.Play("VS"), decide("chammak challo from ra one", bihari, mani, vishal))
+        assertEquals(Online.Play("BR"), decide("chammak challo from ra one", bihari, bracketOnly))
+    }
+
+    @Test
+    fun movieQualifierWithNoMatchingVersionRefuses() {
+        assertTrue(decide("chammak challo from ra one", bihari, mani) is Online.Refuse)
+    }
+
+    @Test
+    fun titleOnlyWithSeveralSameTitleVersionsRefuses() {
+        assertTrue(decide("chammak challo", vishal, mani, bihari) is Online.Refuse)
+        assertTrue(decide("chammak challo", bihari, vishal) is Online.Refuse)
+    }
+
+    @Test
+    fun titleOnlyPlaysOnlyWhenSingleHitIsFirstResult() {
+        val other = Cand("Another Song", listOf("X"), "Y", "OT")
+        assertEquals(Online.Play("VS"), decide("chammak challo", vishal, other))
+        assertTrue(decide("chammak challo", other, vishal) is Online.Refuse)
+    }
+
+    @Test
+    fun artistSpokenSelectsThatArtist() {
+        assertEquals(Online.Play("VS"), decide("chammak challo by vishal shekhar", vishal, bihari))
+        assertTrue(decide("chammak challo by nobody", vishal, bihari) is Online.Refuse)
+    }
+
+    @Test
+    fun unaskedVariantNeverPlays() {
+        val slowed = Cand("Chammak Challo (Slowed)", listOf("DJ"), "x", "SL")
+        assertTrue(decide("chammak challo", slowed) is Online.Refuse)
+    }
+
+    @Test
+    fun likedQualifiedChecksAlbum() {
+        val liked = listOf(bihari, vishal)
+        val s = VoiceTitleMatcher.parse("chammak challo from ra one")
+        assertEquals(VoiceTitleMatcher.Liked.Play(1), VoiceTitleMatcher.matchLikedQualified(s, liked))
+        assertEquals(
+            VoiceTitleMatcher.Liked.None,
+            VoiceTitleMatcher.matchLikedQualified(s, listOf(bihari)),
+        )
+        // no qualifier: unchanged behaviour (two same titles = ambiguous)
+        assertTrue(
+            VoiceTitleMatcher.matchLikedQualified(VoiceTitleMatcher.parse("chammak challo"), liked) is VoiceTitleMatcher.Liked.Ambiguous,
+        )
+    }
+}
