+package com.maxrave.media3.voice
+
+import com.maxrave.media3.voice.VoiceWakeGate.Verdict
+import com.maxrave.media3.voice.VoiceWakeGate.Word
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceWakeGateTest {
+    private val good = listOf(Word("hey", 1.0, 0.10, 0.35), Word("ben", 0.95, 0.35, 0.70))
+
+    @Test
+    fun acceptsExactPhraseWithGoodConfidenceAndSpan() {
+        assertEquals(Verdict.Accept, VoiceWakeGate.judge("hey ben", "hey ben", good))
+    }
+
+    @Test
+    fun rejectsNoiseWordsLowConfidenceBadSpanAndMissingTimings() {
+        assertTrue(VoiceWakeGate.judge("hey ben", "hey [unk]", good) is Verdict.Reject)
+        assertTrue(VoiceWakeGate.judge("hey ben", "hey ben", null) is Verdict.Reject)
+        assertTrue(VoiceWakeGate.judge("hey ben", "hey ben", listOf(Word("hey", 1.0, 0.1, 0.3), Word("ben", 0.5, 0.3, 0.7))) is Verdict.Reject)
+        assertTrue(VoiceWakeGate.judge("hey ben", "hey ben", listOf(Word("hey", 1.0, 0.1, 0.15), Word("ben", 1.0, 0.15, 0.20))) is Verdict.Reject)
+        assertTrue(VoiceWakeGate.judge("hey ben", "hey ben", listOf(Word("hey", 1.0, 0.0, 1.0), Word("ben", 1.0, 1.0, 2.5))) is Verdict.Reject)
+        assertTrue(VoiceWakeGate.judge("hey ben", "so hey ben", good) is Verdict.Reject)
+    }
+}
