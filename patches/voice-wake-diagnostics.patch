+    private fun showLastWakeCheck(text: String) {
+        Logger.w(TAG, "last wake check: $text")
+        handler.post {
+            if (stopping) return@post
+            try {
+                val n =
+                    NotificationCompat
+                        .Builder(this, CHANNEL_ID)
+                        .setSmallIcon(android.R.drawable.ic_btn_speak_now)
+                        .setContentTitle("Last wake check")
+                        .setContentText(text.lineSequence().first())
+                        .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+                        .setOnlyAlertOnce(true)
+                        .setAutoCancel(false)
+                        .build()
+                getSystemService(NotificationManager::class.java).notify(NOTIFICATION_ID + 1, n)
+            } catch (e: Exception) {
+                Logger.w(TAG, "last wake check notify failed: ${e.message}")
+            }
+        }
+    }
