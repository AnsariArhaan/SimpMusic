+    /** One-line, text-only account of a wake-stage final: exact words, per-word confidence and timing. */
+    fun describe(
+        text: String,
+        words: List<Word>?,
+    ): String {
+        if (words == null) return "text \"$text\", no word list"
+        val parts =
+            words.joinToString(" | ") {
+                val c = it.conf?.let { v -> "%.2f".format(v) } ?: "missing"
+                "${it.word} conf $c ${"%.2f".format(it.start)}-${"%.2f".format(it.end)}s"
+            }
+        val span = if (words.isEmpty()) "none" else "%.2fs".format(words.last().end - words.first().start)
+        return "text \"$text\": $parts, span $span"
+    }
 }
