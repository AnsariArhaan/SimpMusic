     private val qualifier =
         Regex("(?i)\\s+(from|in|on)\\s+(my\\s+)?(liked|favou?rite)s?( songs)?\\s*$")
 
+    /** The cleaned query [resolve] actually searches for (diagnostic display only). */
+    fun cleaned(query: String): String = query.trim().replace(qualifier, "").trim().lowercase()
+
+    /** Titles that contain the cleaned query (diagnostic display only; does not change [resolve]). */
+    fun candidates(
+        query: String,
+        titles: List<String>,
+    ): List<String> {
+        val wanted = cleaned(query)
+        if (wanted.isEmpty()) return emptyList()
+        return titles.filter { it.lowercase().contains(wanted) }
+    }
