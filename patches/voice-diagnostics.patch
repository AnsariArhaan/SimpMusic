@@ -0,0 +1,15 @@
+package com.maxrave.media3.voice
+
+/**
+ * Fork-added: carries a short, transient status line from the media session (which knows whether a
+ * liked song matched) to [VoiceListenService] (which shows it on screen). Text only: never stored,
+ * never audio. The sink is set while the listener service runs and cleared when it stops.
+ */
+internal object VoiceDiagnostics {
+    @Volatile
+    var sink: ((String) -> Unit)? = null
+
+    fun report(message: String) {
+        sink?.invoke(message)
+    }
+}
