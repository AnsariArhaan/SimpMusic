+package com.maxrave.media3.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceCommandParserTest {
+    @Test
+    fun wakeDetection() {
+        assertTrue(VoiceCommandParser.isWake("hey ben"))
+        assertTrue(VoiceCommandParser.isWake("Hey Ben play something"))
+        assertFalse(VoiceCommandParser.isWake("play ben e king"))
+        assertFalse(VoiceCommandParser.isWake(""))
+    }
+
+    @Test
+    fun stripsWakeAndVerb() {
+        assertEquals("royalty", VoiceCommandParser.commandFrom("hey ben play royalty"))
+        assertEquals("royalty", VoiceCommandParser.commandFrom("Hey Ben, play royalty"))
+        assertEquals("royalty", VoiceCommandParser.commandFrom("hey ben please play royalty"))
+        assertEquals("royalty", VoiceCommandParser.commandFrom("hey ben royalty"))
+    }
+
+    @Test
+    fun keepsLikedSongsQualifierForMatcher() {
+        assertEquals(
+            "royalty from liked songs",
+            VoiceCommandParser.commandFrom("hey ben play royalty from liked songs"),
+        )
+    }
+
+    @Test
+    fun wakeOnlyIsEmpty() {
+        assertEquals("", VoiceCommandParser.commandFrom("hey ben"))
+        assertEquals("", VoiceCommandParser.commandFrom("  hey ben  "))
+    }
+
+    @Test
+    fun noWakeKeepsWholeUtterance() {
+        assertEquals("royalty", VoiceCommandParser.commandFrom("royalty"))
+    }
+
+    @Test
+    fun doesNotStripPlayInsideTitle() {
+        assertEquals("play date", VoiceCommandParser.commandFrom("hey ben play play date"))
+    }
+}
