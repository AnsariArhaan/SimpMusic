+package com.maxrave.media3.voice
+
+/**
+ * Turns what the offline recognizer heard into a search query for [VoiceLikedSongMatcher] via the
+ * media session. Pure Kotlin so it is unit-testable on the JVM.
+ *
+ * The recognizer hears the wake phrase and command as one stream, for example
+ * "hey ben play royalty". The wake phrase and the leading verb are stripped here; the liked-song
+ * qualifier ("from liked songs") is stripped by VoiceLikedSongMatcher itself. An empty remainder
+ * means the user said only the wake phrase, so nothing plays.
+ */
+internal object VoiceCommandParser {
+    const val WAKE_PHRASE = "hey ben"
+
+    private val wakePrefix = Regex("(?i)^\\s*hey\\s+ben\\b[,.!?]?\\s*")
+    private val leadIn =
+        Regex("(?i)^(?:(?:please|plz)\\s+)?(?:(?:play|put on|sunao|bajao|chala(?:o| do)?|start)\\s+)?")
+
+    fun isWake(text: String): Boolean = text.lowercase().contains(WAKE_PHRASE)
+
+    fun commandFrom(text: String): String = text.trim().replace(wakePrefix, "").replace(leadIn, "").trim()
+}
