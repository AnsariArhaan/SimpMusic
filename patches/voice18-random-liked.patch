+++ b/media/media3/src/test/java/com/maxrave/media3/service/callback/VoiceRandomLikedTest.kt
@@ -0,0 +1,48 @@
+package com.maxrave.media3.service.callback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Pins the voice18 generic-request gate: only the exact phrase "a song" (what remains after
+ * VoiceCommandParser strips the leading "play") may trigger a random Liked play. Everything else,
+ * including near-misses and unapproved aliases, must keep the old behavior.
+ */
+class VoiceRandomLikedTest {
+    @Test
+    fun exactPhraseIsAccepted() {
+        assertTrue(VoiceTitleMatcher.isRandomLikedRequest("a song"))
+    }
+
+    @Test
+    fun nearMissesAndUnapprovedAliasesAreRejected() {
+        // Not the approved exact phrase: these must NOT random-play.
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("song"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("a songs"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("music"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("anything"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("something"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("gaana"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("kuch bhi"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest(""))
+    }
+
+    @Test
+    fun realTitlesKeepTheirNormalPath() {
+        // A named request must never be treated as the generic one, even when it shares a word.
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("royalty"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("song 2"))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest("write this down a song"))
+    }
+
+    @Test
+    fun parserOutputForPlayASongIsTheGenericPhrase() {
+        // The command parser strips the leading verb: "hey zora play a song" reaches the matcher
+        // as exactly "a song"; other phrasings do not.
+        assertEquals("a song", VoiceTitleMatcher.parse("a song").full)
+        assertTrue(VoiceTitleMatcher.isRandomLikedRequest(VoiceTitleMatcher.parse("a song").full))
+        assertFalse(VoiceTitleMatcher.isRandomLikedRequest(VoiceTitleMatcher.parse("play some music").full))
+    }
+}
