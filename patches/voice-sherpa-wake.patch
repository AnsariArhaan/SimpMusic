@@ -0,0 +1,36 @@
+package com.maxrave.media3.voice
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceKeywordWakeTest {
+    private val assets = File("src/main/assets/kws")
+
+    @Test
+    fun convertsPcm16ToUnitFloats() {
+        val out = FloatArray(4)
+        VoiceKeywordWake.toFloats(shortArrayOf(0, 16384, -32768, 32767), 4, out)
+        assertEquals(0f, out[0], 0f)
+        assertEquals(0.5f, out[1], 0f)
+        assertEquals(-1f, out[2], 0f)
+        assertTrue(out[3] < 1f && out[3] > 0.999f)
+    }
+
+    @Test
+    fun keywordLineIsOneKeywordWithKnownTokensAndSaneThresholds() {
+        val lines = File(assets, "keywords.txt").readLines().filter { it.isNotBlank() }
+        assertEquals("exactly one wake keyword", 1, lines.size)
+        val parts = lines[0].trim().split(' ')
+        val tokens = parts.filter { !it.startsWith(":") && !it.startsWith("#") }
+        val known = File(assets, "tokens.txt").readLines().map { it.substringBefore(' ') }.toSet()
+        assertTrue("tokens missing from tokens.txt: ${tokens.filter { it !in known }}", tokens.all { it in known })
+        // The tokens must spell HEY ZORA, nothing else.
+        assertEquals("HEY ZORA", tokens.joinToString("").replace("\u2581", " ").trim())
+        val score = parts.first { it.startsWith(":") }.drop(1).toFloat()
+        val threshold = parts.first { it.startsWith("#") }.drop(1).toFloat()
+        assertTrue(score in 0.5f..4f)
+        assertTrue(threshold in 0.1f..0.9f)
+    }
+}
