+package com.maxrave.media3.voice
+
+import android.annotation.SuppressLint
+import android.content.res.AssetManager
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaRecorder
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.KeywordSpotter
+import com.k2fsa.sherpa.onnx.KeywordSpotterConfig
+import com.k2fsa.sherpa.onnx.OnlineModelConfig
+import com.k2fsa.sherpa.onnx.OnlineTransducerModelConfig
+import com.maxrave.logger.Logger
+
+/**
+ * Wake-word detection with the sherpa-onnx streaming keyword spotter (offline, on-device). It
+ * replaces the Vosk phrase grammar for the wake stage only: the grammar always force-fitted
+ * background sound to the phrase. The spotter only reports a keyword from the line(s) in
+ * assets/kws/keywords.txt. Audio stays in memory; nothing is recorded to disk or sent anywhere.
+ *
+ * The trigger threshold and boost in keywords.txt are starting values, NOT measured on the user's
+ * voice or room. Detections are shown in the "Last wake check" notification.
+ */
+internal class VoiceKeywordWake(
+    private val spotter: KeywordSpotter,
+) {
+    @Volatile private var running = false
+    private var thread: Thread? = null
+
+    /** Called on the audio thread for each detection; the caller must hop to its own thread. */
+    fun start(
+        onDetect: (keyword: String, tokens: String, timestamps: String) -> Unit,
+        onFault: (String) -> Unit,
+    ) {
+        if (running) return
+        running = true
+        val t =
+            Thread({ loop(onDetect, onFault) }, "voice-kws").also {
+                it.isDaemon = true
+                thread = it
+            }
+        t.start()
+    }
+
+    /** Stops the audio thread and waits briefly so the microphone is free for the next stage. */
+    fun stop() {
+        running = false
+        val t = thread ?: return
+        thread = null
+        try {
+            t.join(1500)
+        } catch (_: InterruptedException) {
+            Thread.currentThread().interrupt()
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun loop(
+        onDetect: (String, String, String) -> Unit,
+        onFault: (String) -> Unit,
+    ) {
+        var record: AudioRecord? = null
+        var stream: com.k2fsa.sherpa.onnx.OnlineStream? = null
+        try {
+            val min = AudioRecord.getMinBufferSize(SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+            if (min <= 0) {
+                onFault("audio buffer size $min")
+                return
+            }
+            record =
+                AudioRecord(
+                    MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                    SAMPLE_RATE,
+                    AudioFormat.CHANNEL_IN_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT,
+                    maxOf(min, SAMPLE_RATE),
+                )
+            if (record.state != AudioRecord.STATE_INITIALIZED) {
+                onFault("microphone not available")
+                return
+            }
+            stream = spotter.createStream()
+            record.startRecording()
+            val shorts = ShortArray(CHUNK)
+            val floats = FloatArray(CHUNK)
+            while (running) {
+                val n = record.read(shorts, 0, CHUNK)
+                if (n < 0) {
+                    onFault("audio read error $n")
+                    return
+                }
+                if (n == 0) {
+                    Thread.sleep(10)
+                    continue
+                }
+                toFloats(shorts, n, floats)
+                stream.acceptWaveform(if (n == CHUNK) floats else floats.copyOf(n), SAMPLE_RATE)
+                while (running && spotter.isReady(stream)) {
+                    spotter.decode(stream)
+                    val r = spotter.getResult(stream)
+                    if (r.keyword.isNotEmpty()) {
+                        spotter.reset(stream)
+                        onDetect(
+                            r.keyword,
+                            r.tokens.joinToString(" "),
+                            r.timestamps.joinToString(", ") { "%.2f".format(it) },
+                        )
+                    }
+                }
+            }
+        } catch (e: Throwable) {
+            Logger.e(TAG, "keyword listener failed: ${e.message}")
+            onFault("keyword listener failed: ${e.message}")
+        } finally {
+            try {
+                record?.stop()
+            } catch (_: Exception) {
+            }
+            try {
+                record?.release()
+            } catch (_: Exception) {
+            }
+            try {
+                stream?.release()
+            } catch (_: Exception) {
+            }
+        }
+    }
+
+    companion object {
+        private const val TAG = "VoiceKeywordWake"
+        const val SAMPLE_RATE = 16000
+        private const val CHUNK = 1600 // 100 ms
+
+        /** PCM16 to the -1..1 floats the spotter expects. */
+        internal fun toFloats(
+            shorts: ShortArray,
+            n: Int,
+            out: FloatArray,
+        ) {
+            for (i in 0 until n) out[i] = shorts[i] / 32768f
+        }
+
+        /** Builds the spotter from assets/kws (model files are fetched and hash-checked in CI). */
+        fun createSpotter(assets: AssetManager): KeywordSpotter {
+            val model =
+                OnlineModelConfig(
+                    transducer =
+                        OnlineTransducerModelConfig(
+                            encoder = "kws/encoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx",
+                            decoder = "kws/decoder-epoch-12-avg-2-chunk-16-left-64.onnx",
+                            joiner = "kws/joiner-epoch-12-avg-2-chunk-16-left-64.int8.onnx",
+                        ),
+                    tokens = "kws/tokens.txt",
+                    numThreads = 1,
+                    modelType = "zipformer2",
+                )
+            val config =
+                KeywordSpotterConfig(
+                    featConfig = FeatureConfig(sampleRate = SAMPLE_RATE, featureDim = 80),
+                    modelConfig = model,
+                    keywordsFile = "kws/keywords.txt",
+                )
+            return KeywordSpotter(assets, config)
+        }
+    }
+}
