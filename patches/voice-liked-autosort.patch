+package com.maxrave.data.repository
+
+import DatabaseDao
+import androidx.room.Room
+import androidx.sqlite.driver.bundled.BundledSQLiteDriver
+import com.maxrave.data.db.Converters
+import com.maxrave.data.db.MusicDatabase
+import com.maxrave.data.db.datasource.LocalDataSource
+import com.maxrave.domain.data.entities.SongEntity
+import com.maxrave.domain.data.model.librarysort.LikedBucket
+import com.maxrave.domain.data.model.librarysort.LikedSortRules
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.runBlocking
+import kotlinx.datetime.LocalDateTime
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/**
+ * Sorter tests against the real Room DAO and the real [MusicDatabase] schema on an in-memory
+ * SQLite database (bundled driver, desktop JVM). Nothing is mocked; Android itself is not
+ * exercised. Mirrors [ImportLikedRegressionTest]'s setup, including the sync dependency the
+ * 2.6.0 [LocalDataSource] constructor takes.
+ */
+class LikedSongSorterTest {
+    private lateinit var db: MusicDatabase
+    private lateinit var dao: DatabaseDao
+    private lateinit var dataSource: LocalDataSource
+
+    @BeforeTest
+    fun setUp() {
+        db =
+            Room
+                .inMemoryDatabaseBuilder<MusicDatabase>()
+                .addTypeConverter(Converters())
+                .setDriver(BundledSQLiteDriver())
+                .setQueryCoroutineContext(Dispatchers.IO)
+                .build()
+        dao = db.getDatabaseDao()
+        dataSource =
+            LocalDataSource(
+                dao,
+                db,
+                com.maxrave.data.librarysync.SyncChangeRecorder(
+                    db.getSyncDao(),
+                    com.maxrave.data.librarysync.SyncPrefs(
+                        object : androidx.datastore.core.DataStore<androidx.datastore.preferences.core.Preferences> {
+                            private val state =
+                                kotlinx.coroutines.flow.MutableStateFlow(
+                                    androidx.datastore.preferences.core.emptyPreferences(),
+                                )
+                            override val data: kotlinx.coroutines.flow.Flow<androidx.datastore.preferences.core.Preferences> = state
+
+                            override suspend fun updateData(
+                                transform: suspend (androidx.datastore.preferences.core.Preferences) -> androidx.datastore.preferences.core.Preferences,
+                            ): androidx.datastore.preferences.core.Preferences {
+                                val updated = transform(state.value)
+                                state.value = updated
+                                return updated
+                            }
+                        },
+                    ),
+                ),
+            )
+    }
+
+    @AfterTest
+    fun tearDown() {
+        db.close()
+    }
+
+    private fun song(
+        id: String,
+        title: String,
+        artist: String,
+        liked: Boolean = true,
+    ) = SongEntity(
+        videoId = id,
+        duration = "3:00",
+        durationSeconds = 180,
+        isAvailable = true,
+        isExplicit = false,
+        likeStatus = "",
+        title = title,
+        videoType = "",
+        category = null,
+        resultType = null,
+        liked = liked,
+        totalPlayTime = 0,
+        favoriteAt = LocalDateTime(2026, 1, 1, 0, 0),
+        artistName = listOf(artist),
+    )
+
+    private fun sorter(
+        rules: LikedSortRules = LikedSortRules(),
+        removeOnUnlike: Boolean = false,
+    ) = LikedSongSorter(dataSource, removeOnUnlike = removeOnUnlike) { rules }
+
+    private fun tracksOf(title: String): List<String> =
+        runBlocking { dao.getLocalPlaylistByTitle(title)?.tracks.orEmpty() }
+
+    @Test
+    fun firstPassCreatesThreePlaylistsAndFilesEveryLikedSong() {
+        val rules = LikedSortRules(artistRules = mapOf("Akon" to "english"))
+        runBlocking {
+            dao.insertSong(song("p1", "MONTAGEM X", "DJ X"))
+            dao.insertSong(song("e1", "Lonely", "Akon"))
+            dao.insertSong(song("h1", "Aankhein Khuli", "Lata Mangeshkar"))
+            dao.insertSong(song("u1", "Not Liked", "Akon", liked = false))
+
+            val result = sorter(rules).sortAllLiked()
+
+            assertEquals(3, result.playlistsCreated)
+            assertEquals(3, result.songsAdded)
+            assertEquals(0, result.alreadyInPlaylist)
+            assertEquals(1, result.phonkAdded)
+            assertEquals(1, result.englishAdded)
+            assertEquals(1, result.hindiAdded)
+            assertEquals(listOf("p1"), tracksOf("Phonk"))
+            assertEquals(listOf("e1"), tracksOf("English"))
+            assertEquals(listOf("h1"), tracksOf("Hindi"))
+            // The unliked song is untouched, and the sort never flips liked flags.
+            assertTrue(dao.getSong("p1")!!.liked)
+            assertTrue(tracksOf("English").none { it == "u1" })
+        }
+    }
+
+    @Test
+    fun secondPassIsIdempotentNoDuplicatePairsOrTracks() {
+        runBlocking {
+            dao.insertSong(song("e1", "Lonely", "Akon"))
+            val s = sorter(LikedSortRules(artistRules = mapOf("Akon" to "english")))
+            s.sortAllLiked()
+
+            val second = s.sortAllLiked()
+
+            assertEquals(0, second.playlistsCreated)
+            assertEquals(0, second.songsAdded)
+            assertEquals(1, second.alreadyInPlaylist)
+            assertEquals(listOf("e1"), tracksOf("English"))
+            val playlistId = dao.getLocalPlaylistByTitle("English")!!.id
+            assertNotNull(dao.findPlaylistPairOfSongNullable("e1", playlistId))
+        }
+    }
+
+    @Test
+    fun onLikedFilesTheNewSongIntoItsBucket() {
+        runBlocking {
+            dao.insertSong(song("e1", "Lonely", "Akon"))
+            val s = sorter(LikedSortRules(artistRules = mapOf("Akon" to "english")))
+            s.sortAllLiked()
+            dao.insertSong(song("e2", "Smack That", "Akon"))
+
+            val bucket = s.onLiked("e2")
+
+            assertEquals(LikedBucket.ENGLISH, bucket)
+            assertEquals(listOf("e1", "e2"), tracksOf("English"))
+        }
+    }
+
+    @Test
+    fun onUnlikedRemovesOnlyWhenRemovalIsEnabled() {
+        runBlocking {
+            dao.insertSong(song("e1", "Lonely", "Akon"))
+            val rules = LikedSortRules(artistRules = mapOf("Akon" to "english"))
+            val keeping = sorter(rules, removeOnUnlike = false)
+            keeping.sortAllLiked()
+
+            keeping.onUnliked("e1")
+            assertEquals(listOf("e1"), tracksOf("English"))
+
+            val removing = sorter(rules, removeOnUnlike = true)
+            removing.onUnliked("e1")
+            assertEquals(emptyList(), tracksOf("English"))
+            val playlistId = dao.getLocalPlaylistByTitle("English")!!.id
+            assertNull(dao.findPlaylistPairOfSongNullable("e1", playlistId))
+        }
+    }
+}
