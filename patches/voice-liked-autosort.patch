@@ -0,0 +1,70 @@
+package com.maxrave.data.repository
+
+import com.maxrave.domain.data.model.librarysort.LikedBucket
+import com.maxrave.domain.data.model.librarysort.LikedSortRules
+import com.maxrave.domain.data.model.librarysort.LikedSongClassifier
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+/**
+ * Pure classifier tests - no database. The contract being pinned: overrides win, artist rules
+ * beat title tokens, word-boundary phonk tokens only fire on self-labelling titles, and anything
+ * unresolved falls through to Hindi.
+ */
+class LikedSongClassifierTest {
+    private fun classify(
+        videoId: String = "v1",
+        title: String,
+        albumName: String? = null,
+        artists: List<String> = emptyList(),
+        rules: LikedSortRules = LikedSortRules(),
+    ) = LikedSongClassifier.bucketFor(videoId, title, albumName, artists, rules)
+
+    @Test
+    fun songOverrideWinsOverArtistAndToken() {
+        val rules =
+            LikedSortRules(
+                artistRules = mapOf("Akon" to "english"),
+                songOverrides = mapOf("v1" to "phonk"),
+            )
+        assertEquals(LikedBucket.PHONK, classify(title = "ordinary", artists = listOf("Akon"), rules = rules))
+    }
+
+    @Test
+    fun artistRuleBeatsPhonkTokenInTitle() {
+        val rules = LikedSortRules(artistRules = mapOf("Mark Ronson" to "english"))
+        assertEquals(LikedBucket.ENGLISH, classify(title = "Uptown Funk", artists = listOf("Mark Ronson"), rules = rules))
+    }
+
+    @Test
+    fun firstCreditedArtistWithARuleDecides() {
+        val rules = LikedSortRules(artistRules = mapOf("Vishal-Shekhar" to "hindi", "Akon" to "english"))
+        assertEquals(
+            LikedBucket.HINDI,
+            classify(title = "Chammak Challo", artists = listOf("Vishal-Shekhar", "Akon", "Hamsika Iyer"), rules = rules),
+        )
+    }
+
+    @Test
+    fun unknownArtistWithPhonkTokenGoesPhonk() {
+        assertEquals(LikedBucket.PHONK, classify(title = "MONTAGEM X", artists = listOf("DJ Unknown")))
+        assertEquals(LikedBucket.PHONK, classify(title = "Slide da Treme Melódica v2", albumName = "Funk Automotivo"))
+    }
+
+    @Test
+    fun wordBoundariesKeepFunkytownOutOfPhonk() {
+        assertEquals(LikedBucket.HINDI, classify(title = "Funkytown", artists = listOf("Lipps Inc.")))
+    }
+
+    @Test
+    fun unknownEverythingFallsThroughToHindi() {
+        assertEquals(LikedBucket.HINDI, classify(title = "Aankhein Khuli", artists = listOf("Lata Mangeshkar")))
+        assertEquals(LikedBucket.HINDI, classify(title = "Gasolina", artists = listOf("Daddy Yankee")))
+    }
+
+    @Test
+    fun unrecognizedRuleValuesAreIgnored() {
