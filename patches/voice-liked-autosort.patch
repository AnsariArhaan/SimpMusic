+package com.maxrave.domain.data.model.librarysort
+
+/**
+ * The three fixed personal playlists a liked song is filed into. The taxonomy is exact: phonk
+ * goes to Phonk, English goes to English, and every other language goes to Hindi - there is no
+ * fourth bucket.
+ */
+enum class LikedBucket(
+    val playlistTitle: String,
+    val ruleName: String,
+) {
+    PHONK("Phonk", "phonk"),
+    ENGLISH("English", "english"),
+    HINDI("Hindi", "hindi"),
+    ;
+
+    companion object {
+        fun fromRuleName(name: String?): LikedBucket? =
+            when (name?.trim()?.lowercase()) {
+                PHONK.ruleName -> PHONK
+                ENGLISH.ruleName -> ENGLISH
+                HINDI.ruleName -> HINDI
+                else -> null
+            }
+    }
+}
+
+/** What one one-time sort pass did, reported to the user when it finishes. */
+data class LikedSortResult(
+    val playlistsCreated: Int,
+    val songsAdded: Int,
+    val alreadyInPlaylist: Int,
+    val phonkAdded: Int,
+    val englishAdded: Int,
+    val hindiAdded: Int,
+)
+
+/** Private per-song and per-artist bucket rules, carried in from the import file. */
+data class LikedSortRules(
+    val artistRules: Map<String, String> = emptyMap(),
+    val songOverrides: Map<String, String> = emptyMap(),
+)
+
+/**
+ * Rule-based bucket assignment for one song.
+ *
+ * The app stores no genre or language metadata, so this is a heuristic, not the truth about a
+ * song. Per-song overrides win, then the artist table (the first credited artist with a rule
+ * decides), then self-labelling phonk tokens in the title/album, and everything else falls
+ * through to Hindi per the taxonomy. Word boundaries keep "Funkytown" out of Phonk.
+ */
+object LikedSongClassifier {
+    private val PHONK_TOKEN =
+        Regex("\\b(montagem|phonk|funk|batid[aã]o|automotivo)\\b", RegexOption.IGNORE_CASE)
+
+    fun bucketFor(
+        videoId: String,
+        title: String,
+        albumName: String?,
+        artistNames: List<String>,
+        rules: LikedSortRules,
+    ): LikedBucket {
+        LikedBucket.fromRuleName(rules.songOverrides[videoId])?.let { return it }
+        for (artist in artistNames) {
+            LikedBucket.fromRuleName(rules.artistRules[artist])?.let { return it }
+        }
+        if (PHONK_TOKEN.containsMatchIn(title) || PHONK_TOKEN.containsMatchIn(albumName.orEmpty())) return PHONK
+        return HINDI
+    }
+}
