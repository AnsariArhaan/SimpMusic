@@ -0,0 +1,151 @@
+package com.maxrave.data.repository
+
+import com.maxrave.data.db.datasource.LocalDataSource
+import com.maxrave.domain.data.entities.LocalPlaylistEntity
+import com.maxrave.domain.data.entities.PairSongLocalPlaylist
+import com.maxrave.domain.data.entities.SongEntity
+import com.maxrave.domain.data.model.librarysort.LikedBucket
+import com.maxrave.domain.data.model.librarysort.LikedSortResult
+import com.maxrave.domain.data.model.librarysort.LikedSortRules
+import com.maxrave.domain.data.model.librarysort.LikedSongClassifier
+import kotlinx.serialization.json.Json
+
+/**
+ * Files liked songs into the three personal bucket playlists (Phonk / English / Hindi). The
+ * playlists are plain local playlists and are never pushed to YouTube; a song already sitting in
+ * any of the three is never re-added or moved, so the sort is safe to re-run.
+ */
+internal class LikedSongSorter(
+    private val localDataSource: LocalDataSource,
+    private val removeOnUnlike: Boolean = DEFAULT_REMOVE_ON_UNLIKE,
+    private val loadRules: suspend () -> LikedSortRules,
+) {
+    /** Sorts one freshly liked song. No-op when the song row is gone or already bucketed. */
+    suspend fun onLiked(videoId: String): LikedBucket? {
+        val song = localDataSource.getSong(videoId) ?: return null
+        val rules = loadRules()
+        val bucket = bucketFor(song, rules)
+        val playlistId = ensureBucketPlaylistId(bucket)?.first ?: return null
+        addToBucketPlaylist(playlistId, song.videoId)
+        return bucket
+    }
+
+    /** Pulls an unliked song back out of the buckets, only when removal on unlike is enabled. */
+    suspend fun onUnliked(videoId: String) {
+        if (!removeOnUnlike) return
+        for (bucket in LikedBucket.entries) {
+            val playlist = localDataSource.getLocalPlaylistByTitle(bucket.playlistTitle) ?: continue
+            localDataSource.findPlaylistPairOfSongNullable(videoId, playlist.id) ?: continue
+            localDataSource.deletePairSongFromPlaylist(playlist.id, videoId)
+            localDataSource.updateLocalPlaylistTracks(playlist.tracks.orEmpty() - videoId, playlist.id)
+        }
+    }
+
+    /** The one-time pass over the whole liked list, paged so a large library never loads at once. */
+    suspend fun sortAllLiked(): LikedSortResult {
+        val rules = loadRules()
+        val playlistIds = mutableMapOf<LikedBucket, Long>()
+        var playlistsCreated = 0
+        for (bucket in LikedBucket.entries) {
+            val (id, createdHere) = ensureBucketPlaylistId(bucket) ?: continue
+            playlistIds[bucket] = id
+            if (createdHere) playlistsCreated++
+        }
+        var songsAdded = 0
+        var alreadyInPlaylist = 0
+        var phonkAdded = 0
+        var englishAdded = 0
+        var hindiAdded = 0
+        var offset = 0
+        while (true) {
+            val songs = localDataSource.getLikedSongs(PAGE_SIZE, offset)
+            if (songs.isEmpty()) break
+            offset += songs.size
+            for (song in songs) {
+                if (playlistIds.values.any { localDataSource.findPlaylistPairOfSongNullable(song.videoId, it) != null }) {
+                    alreadyInPlaylist++
+                    continue
+                }
+                val bucket = bucketFor(song, rules)
+                val playlistId = playlistIds[bucket] ?: continue
+                if (addToBucketPlaylist(playlistId, song.videoId)) {
+                    songsAdded++
+                    when (bucket) {
+                        LikedBucket.PHONK -> phonkAdded++
+                        LikedBucket.ENGLISH -> englishAdded++
+                        LikedBucket.HINDI -> hindiAdded++
+                    }
+                }
+            }
+        }
+        return LikedSortResult(
+            playlistsCreated = playlistsCreated,
+            songsAdded = songsAdded,
+            alreadyInPlaylist = alreadyInPlaylist,
+            phonkAdded = phonkAdded,
+            englishAdded = englishAdded,
+            hindiAdded = hindiAdded,
+        )
+    }
+
+    private fun bucketFor(
+        song: SongEntity,
+        rules: LikedSortRules,
+    ): LikedBucket =
+        LikedSongClassifier.bucketFor(
+            videoId = song.videoId,
+            title = song.title,
+            albumName = song.albumName,
+            artistNames = song.artistName.orEmpty(),
+            rules = rules,
+        )
+
+    /** @return the playlist id and whether this call created it, or null when both failed. */
+    private suspend fun ensureBucketPlaylistId(bucket: LikedBucket): Pair<Long, Boolean>? {
+        localDataSource.getLocalPlaylistByTitle(bucket.playlistTitle)?.let { return it.id to false }
+        val newId =
+            localDataSource.insertLocalPlaylist(
+                LocalPlaylistEntity(title = bucket.playlistTitle, tracks = emptyList()),
+            )
+        if (newId != -1L) return newId to true
+        // IGNORE dropped the row (a same-title playlist raced in); re-read it.
+        return localDataSource.getLocalPlaylistByTitle(bucket.playlistTitle)?.let { it.id to false }
+    }
+
+    /** @return true when the song was appended, false when it was already there (or went missing). */
+    private suspend fun addToBucketPlaylist(
+        playlistId: Long,
+        videoId: String,
+    ): Boolean {
+        if (localDataSource.findPlaylistPairOfSongNullable(videoId, playlistId) != null) return false
+        val playlist = localDataSource.getLocalPlaylist(playlistId) ?: return false
+        val nextPosition = playlist.tracks?.size ?: 0
+        localDataSource.insertPairSongLocalPlaylist(
+            PairSongLocalPlaylist(
+                playlistId = playlistId,
+                songId = videoId,
+                position = nextPosition,
+            ),
+        )
+        localDataSource.updateLocalPlaylistTracks(playlist.tracks.orEmpty() + videoId, playlistId)
+        return true
+    }
+
+    companion object {
+        /**
+         * Whether unliking a song also pulls it out of the bucket playlists. Both directions stay
+         * implemented; the constant is the owner call and flips in one place.
+         */
+        const val DEFAULT_REMOVE_ON_UNLIKE = false
+
+        private const val PAGE_SIZE = 100
+    }
+}
+
+private val likedSortRulesJson = Json { ignoreUnknownKeys = true }
+
+/** Decodes one stored rules object; an unreadable or absent value means no rules. */
+internal fun decodeLikedSortRules(raw: String?): Map<String, String> =
+    raw
+        ?.let { runCatching { likedSortRulesJson.decodeFromString<Map<String, String>>(it) }.getOrNull() }
+        .orEmpty()
