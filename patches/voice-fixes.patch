@@ -0,0 +1,102 @@
+package com.maxrave.media3.service.callback
+
+/**
+ * Title matching for spoken song requests. Pure Kotlin so it is unit-testable on the JVM.
+ * Fail closed: ambiguous or weak matches never play; they are reported instead.
+ */
+internal object VoiceTitleMatcher {
+    sealed interface Liked {
+        data class Play(
+            val index: Int,
+        ) : Liked
+
+        data class Ambiguous(
+            val indexes: List<Int>,
+        ) : Liked
+
+        object None : Liked
+    }
+
+    private val qualifier = Regex("(?i)\\s+(from|in|on)\\s+(my\\s+)?(liked|favou?rite)s?( songs)?\\s*$")
+    private val bracketed = Regex("[(\\[][^)\\]]*[)\\]]")
+    private val nonWord = Regex("[^\\p{L}\\p{N}]+")
+    private val allowedExtra = setOf("by", "from", "song", "the", "a")
+
+    /** Lower-case words only: brackets (feat., remix tags) and punctuation removed. */
+    fun normalize(text: String): String =
+        text
+            .replace(bracketed, " ")
+            .lowercase()
+            .replace(nonWord, " ")
+            .trim()
+
+    /** The words to search for, without a trailing "from liked songs" qualifier. */
+    fun wantedFrom(query: String): String = normalize(query.trim().replace(qualifier, ""))
+
+    fun matchLiked(
+        wanted: String,
+        titles: List<String>,
+    ): Liked {
+        if (wanted.isEmpty()) return Liked.None
+        val normalized = titles.map { normalize(it) }
+        val exact = normalized.indices.filter { normalized[it] == wanted }
+        if (exact.size == 1) return Liked.Play(exact[0])
+        if (exact.size > 1) return Liked.Ambiguous(exact.take(5))
+        // Very short text is too easy to produce from noise: only a whole-title match may play.
+        if (wanted.length < 4) return Liked.None
+        val padded = " $wanted "
+        val part = normalized.indices.filter { " ${normalized[it]} ".contains(padded) }
+        return when (part.size) {
+            0 -> Liked.None
+            1 -> Liked.Play(part[0])
+            else -> Liked.Ambiguous(part.take(5))
+        }
+    }
+
+    private val variantWords =
+        setOf(
+            "cover", "remix", "live", "karaoke", "instrumental", "slowed", "reverb", "sped", "speed", "nightcore",
+            "lofi", "mashup", "acoustic", "remastered", "version", "edit", "tribute", "8d", "bass", "boosted", "reprise",
+        )
+
+    /** True when the raw title (brackets included) carries a variant tag the user did not ask for. */
+    fun isUnaskedVariant(
+        wanted: String,
+        title: String,
+    ): Boolean {
+        val asked = wanted.split(' ').toSet()
+        val tokens = title.lowercase().split(nonWord).filter { it.isNotEmpty() }
+        return tokens.any { it in variantWords && it !in asked }
+    }
+
+    /** True when the title equals the heard words exactly (after normalising) and is not an unasked variant. */
+    fun isExact(
+        wanted: String,
+        title: String,
+    ): Boolean = wanted.isNotEmpty() && normalize(title) == wanted && !isUnaskedVariant(wanted, title)
+
+    /**
+     * Whether an online search result is a confident match for what was heard: every heard word is
+     * explained by the title, the artist names or a small set of connecting words, at least one is in
+     * the title, and the title is not much longer than the heard words (so a long remix or medley
+     * title does not pass on one shared word).
+     */
+    fun acceptOnline(
+        wanted: String,
+        title: String,
+        artists: List<String>,
+    ): Boolean {
+        if (wanted.length < 4) return false
+        if (isUnaskedVariant(wanted, title)) return false
+        val heard = wanted.split(' ').filter { it.isNotEmpty() }
+        val titleWords = normalize(title).split(' ').filter { it.isNotEmpty() }
+        if (heard.isEmpty() || titleWords.isEmpty()) return false
+        val titleSet = titleWords.toSet()
+        val artistWords = artists.flatMap { normalize(it).split(' ') }.filter { it.isNotEmpty() }.toSet()
+        val explained = titleSet + artistWords + allowedExtra
+        if (!heard.all { it in explained }) return false
+        val inTitle = heard.count { it in titleSet }
+        if (inTitle == 0) return false
+        return inTitle.toDouble() / titleWords.size >= 0.5
+    }
+}
