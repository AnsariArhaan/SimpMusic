+package com.maxrave.media3.service.callback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceTitleMatcherTest {
+    private val liked = listOf("Royalty (feat. Chris)", "Chammak Challo", "Blinding Lights", "Blinding Lights (Remix)", "Believer")
+
+    @Test
+    fun normalizeDropsBracketsAndPunctuation() {
+        assertEquals("royalty", VoiceTitleMatcher.normalize("Royalty (feat. Chris)"))
+        assertEquals("don t stop", VoiceTitleMatcher.normalize("Don't Stop!"))
+    }
+
+    @Test
+    fun qualifierIsStripped() {
+        assertEquals("royalty", VoiceTitleMatcher.wantedFrom("Royalty from my liked songs"))
+    }
+
+    @Test
+    fun singleWordTitleMatchesExactly() {
+        assertEquals(VoiceTitleMatcher.Liked.Play(0), VoiceTitleMatcher.matchLiked("royalty", liked))
+    }
+
+    @Test
+    fun exactBeatsContains() {
+        assertEquals(VoiceTitleMatcher.Liked.Play(2), VoiceTitleMatcher.matchLiked("blinding lights", liked))
+    }
+
+    @Test
+    fun ambiguousPartIsNotPlayed() {
+        val r = VoiceTitleMatcher.matchLiked("lights", listOf("Blinding Lights", "City Lights"))
+        assertTrue(r is VoiceTitleMatcher.Liked.Ambiguous)
+    }
+
+    @Test
+    fun unknownAndTooShortNeverPlay() {
+        assertEquals(VoiceTitleMatcher.Liked.None, VoiceTitleMatcher.matchLiked("phonk", liked))
+        assertEquals(VoiceTitleMatcher.Liked.None, VoiceTitleMatcher.matchLiked("", liked))
+        assertEquals(VoiceTitleMatcher.Liked.None, VoiceTitleMatcher.matchLiked("ben", listOf("Ben 10 Theme")))
+    }
+
+    @Test
+    fun onlineAcceptsClearMatch() {
+        assertTrue(VoiceTitleMatcher.acceptOnline("chammak challo", "Chammak Challo", listOf("Akon")))
+        assertTrue(VoiceTitleMatcher.acceptOnline("royalty by egzod", "Royalty (feat. Neoni)", listOf("EGZOD", "Maestro Chives")))
+    }
+
+    @Test
+    fun onlineRejectsUnrelatedAndLongTitles() {
+        assertFalse(VoiceTitleMatcher.acceptOnline("chammak challo", "Phonk Drift Mix", listOf("DJ X")))
+        assertFalse(VoiceTitleMatcher.acceptOnline("royalty", "Royalty Free Music Medley Of Many Songs Vol 3", listOf("Any")))
+        assertFalse(VoiceTitleMatcher.acceptOnline("ben", "Ben", listOf("Michael Jackson")))
+    }
+
+    @Test
+    fun variantsAreRejectedUnlessAsked() {
+        assertFalse(VoiceTitleMatcher.isExact("royalty", "Royalty (Cover)"))
+        assertFalse(VoiceTitleMatcher.acceptOnline("royalty", "Royalty (Slowed + Reverb)", listOf("Someone")))
+        assertTrue(VoiceTitleMatcher.isExact("royalty", "Royalty (feat. Neoni)"))
+    }
+
+    @Test
+    fun wrongArtistIsRejected() {
+        assertFalse(VoiceTitleMatcher.acceptOnline("royalty by egzod", "Royalty", listOf("Other Artist")))
+    }
+}
