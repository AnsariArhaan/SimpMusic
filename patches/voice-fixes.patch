+package com.maxrave.media3.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoiceQueryGateTest {
+    @Test
+    fun cleanStripsUnknownMarkers() {
+        assertEquals("royalty", VoiceQueryGate.clean("[unk] royalty [unk]"))
+        assertEquals("", VoiceQueryGate.clean("[unk] [UNK]"))
+    }
+
+    @Test
+    fun parserStripsUnknownBeforeWake() {
+        assertEquals("royalty", VoiceCommandParser.commandFrom("[unk] hey ben play royalty"))
+        assertEquals("", VoiceCommandParser.commandFrom("[unk]"))
+    }
+
+    @Test
+    fun singleWordTitleIsUsable() {
+        assertTrue(VoiceQueryGate.usable("royalty"))
+        assertTrue(VoiceQueryGate.usable("chammak challo"))
+    }
+
+    @Test
+    fun noiseAndFillerAreNotUsable() {
+        assertFalse(VoiceQueryGate.usable(""))
+        assertFalse(VoiceQueryGate.usable("[unk]"))
+        assertFalse(VoiceQueryGate.usable("the"))
+        assertFalse(VoiceQueryGate.usable("uh um"))
+        assertFalse(VoiceQueryGate.usable("a b c d e f g h i j k l m n"))
+    }
+
+    @Test
+    fun cancelWords() {
+        assertTrue(VoiceQueryGate.isCancel("never mind"))
+        assertTrue(VoiceQueryGate.isCancel("Cancel."))
+        assertFalse(VoiceQueryGate.isCancel("cancel culture song"))
+    }
+
+    @Test
+    fun wakeOnlyIsStrict() {
+        assertTrue(VoiceCommandParser.isWakeOnly(" Hey Ben "))
+        assertFalse(VoiceCommandParser.isWakeOnly("[unk] hey ben"))
+        assertFalse(VoiceCommandParser.isWakeOnly("hey ben play"))
+    }
+
+    @Test
+    fun stopIsNotCancel() {
+        assertFalse(VoiceQueryGate.isCancel("stop"))
+    }
+}
