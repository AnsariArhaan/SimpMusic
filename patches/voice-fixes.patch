@@ -0,0 +1,32 @@
+package com.maxrave.media3.voice
+
+/**
+ * Content checks on recognised text before anything is allowed to play. Pure Kotlin so it is
+ * unit-testable on the JVM. Fail closed: when the text does not look like a song request, the
+ * answer is "do nothing", never "guess".
+ */
+internal object VoiceQueryGate {
+    private val unk = Regex("(?i)\\[unk]")
+    private val spaces = Regex("\\s+")
+    private val filler =
+        setOf("the", "a", "an", "uh", "um", "umm", "hmm", "huh", "oh", "ah", "hey", "ben", "play", "and", "to", "of", "is", "it", "i")
+    private val cancelPhrases = setOf("cancel", "never mind", "nevermind", "resume", "continue")
+    private const val MAX_WORDS = 12
+
+    /** Drops the recognizer's unknown-word markers and tidies spaces. */
+    fun clean(text: String): String = text.replace(unk, " ").replace(spaces, " ").trim()
+
+    fun isCancel(query: String): Boolean = clean(query).lowercase().trimEnd('.', '!', '?') in cancelPhrases
+
+    /**
+     * True when [query] could plausibly be a song request: not empty, not a long run of noise, and
+     * at least one real word that is not just a filler word. A single title such as "Royalty" passes.
+     */
+    fun usable(query: String): Boolean {
+        val words = clean(query).split(' ').filter { it.isNotEmpty() }
+        if (words.isEmpty() || words.size > MAX_WORDS) return false
+        return words.any { w ->
+            w.lowercase() !in filler && w.count { it.isLetterOrDigit() } >= 2
+        }
+    }
+}
